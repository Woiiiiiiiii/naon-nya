# Output files (generated videos, music, temp files)
engine/output/

# Music library (cached in CI via GitHub Actions cache, not in repo)
engine/assets/music/

# State files (runtime data, not config)
engine/state/*.csv
engine/state/*.json
# EXCEPTION: used_products.json MUST be tracked for permanent product dedup
!engine/state/used_products.json

# Queue files (regenerated every run)
engine/queue/*.jsonl

# Temp/cache
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
*.egg

# MoviePy temp files
*TEMP_MPY*

# OS files
Thumbs.db
.DS_Store
desktop.ini

# IDE
.vscode/
.idea/

# Env
.env
venv/
env/

# YouTube API credentials (SENSITIVE — NEVER commit to public repo!)
engine/config/client_secret.json
engine/config/yt_token.pickle
engine/config/tokens/*_client_secret.json
engine/config/tokens/*.pickle
engine/config/tokens/*_refresh_token.txt

# Facebook API credentials
engine/config/fb_config.json

# Private docs
Affiliate.txt

# Logs
*.log